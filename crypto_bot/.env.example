# ─────────────────────────────────────────────────────────
#  Copiez ce fichier en ".env" et remplissez vos valeurs
#  Ne commitez JAMAIS le fichier .env sur GitHub !
# ─────────────────────────────────────────────────────────

# Clés API Binance (créez-les sur binance.com → Mon compte → API Management)
# Permissions nécessaires : "Enable Spot & Margin Trading" uniquement
# Laissez les retraits DÉSACTIVÉS pour la sécurité
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Mode testnet : "true" = simulation sans argent réel, "false" = production
# Testez TOUJOURS en testnet avant de passer en production !
TESTNET=true

# ── Notifications Telegram ────────────────────────────────
# 1. Créez un bot via @BotFather sur Telegram → obtenez TELEGRAM_TOKEN
# 2. Envoyez un message à votre bot, puis récupérez votre chat_id via :
#    https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
